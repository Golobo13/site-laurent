# Variables d'environnement pour l'envoi du formulaire de contact (api/contact.js)
# À configurer dans Vercel : Project Settings > Environment Variables

# Clé API Resend (https://resend.com) — obligatoire
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire (défaut : l.garnero@expertgcl.fr)
CONTACT_TO_EMAIL=

# Adresse d'expédition — doit venir d'un domaine vérifié dans Resend
# (par défaut : onboarding@resend.dev, une adresse de test Resend limitée en volume)
CONTACT_FROM_EMAIL=
