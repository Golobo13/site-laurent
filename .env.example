# Variables d'environnement pour l'envoi du formulaire de contact (api/contact.js)
# À configurer dans Vercel : Project Settings > Environment Variables
#
# Deux emails sont envoyés à chaque soumission : une notification interne
# (vers CONTACT_TO_EMAIL) et un accusé de réception envoyé au contact avec
# le récapitulatif de ses informations.
#
# Important : sans domaine vérifié dans Resend, le compte reste en mode
# « bac à sable » et ne peut envoyer qu'à l'adresse utilisée pour créer le
# compte Resend — l'accusé de réception au contact ne sera donc réellement
# délivré qu'une fois un domaine vérifié.

# Clé API Resend (https://resend.com) — obligatoire
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire — peut être une simple
# adresse Gmail (défaut : l.garnero@expertgcl.fr)
CONTACT_TO_EMAIL=

# Adresse d'expédition — doit venir d'un domaine vérifié dans Resend
# (par défaut : onboarding@resend.dev, une adresse de test Resend limitée en volume)
CONTACT_FROM_EMAIL=
